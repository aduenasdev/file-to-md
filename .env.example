# Perfil: auto | quality | balanced | light
PROFILE=auto
# cpu | cuda | auto
DEVICE=auto
ENGINE_PYMUPDF_ENABLED=true
ENGINE_MARKITDOWN_ENABLED=true
ENGINE_DOCLING_ENABLED=true
ENGINE_MARKER_ENABLED=true
MAX_UPLOAD_MB=50
# Conversiones simultáneas (los motores con IA consumen mucha RAM/CPU)
MAX_CONCURRENCY=1
TIMEOUT_S=1800
# Hilos de CPU por conversión (0 = sin límite)
THREADS=0
# Marker en CPU necesita llama-server (llama.cpp)
# LLAMA_CPP_BINARY=/usr/local/bin/llama-server
